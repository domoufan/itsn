# Copier en .env (non versionné) et renseigner les valeurs. Aucun secret réel dans ce fichier d'exemple.
POSTGRES_DB=intervit
POSTGRES_USER=intervit
POSTGRES_PASSWORD=change-me-locally

# Backend
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-64-caracteres-minimum
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
SEED_ENABLED=true
EMAIL_ENABLED=true

# Agent IA (laisser AI_ENABLED=false pour utiliser la simulation locale)
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_DAILY_BUDGET_USD=1.00
